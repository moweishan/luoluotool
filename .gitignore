# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 构建产物与二进制：**一律不入库**（2026-09-19 用户要求：不要提交构建好的 exe 及相关文件）
# dist/LuoLuoTool 里还会生成 user_data/ 与 logs/，随 dist 一起忽略
build/
dist/
*.manifest
# 可执行与本地二进制（哪怕被拷到别处也不许入库）
*.exe
*.pyd
*.dll
*.zip
# PyInstaller 中间产物（自定义 --workpath/--distpath 时可能落在仓库根）
*.pyz
*.pkg
warn-*.txt
xref-*.html

# 运行时本地数据（个人数据，不入库）
logs/
user_data/config.json
user_data/config.json.bak-*
user_data/debug/
# 图像识别图片目录（2026-09-20 用户要求的三个目录）
# assets/templates/：用户自己整理/命名的识别图片 —— **要入库**，因此这里不忽略（人工整理、体积小）
# assets/screenshots/：识别底图（用工具自带截图功能截的画面）—— 原始素材，不入库
# assets/anchors/：开发者调试页框选产物（anchor_<时间戳>.png）—— 原始素材，不入库
assets/anchors/*.png
assets/screenshots/*.png
assets/screenshots/*.jpg
assets/screenshots/*.jpeg
assets/screenshots/*.bmp
assets/screenshots/*.webp

# 编辑器
.idea/
.vscode/
*.swp
