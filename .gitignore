# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 构建产物与二进制：**一律不入库**（2026-09-19 用户要求：不要提交构建好的 exe 及相关文件）
# dist/LuoLuoTool 里还会生成 user_data/ 与 logs/，随 dist 一起忽略
build/
dist/
*.manifest
# 可执行与本地二进制（哪怕被拷到别处也不许入库）
*.exe
*.pyd
*.dll
*.zip
# PyInstaller 中间产物（自定义 --workpath/--distpath 时可能落在仓库根）
*.pyz
*.pkg
warn-*.txt
xref-*.html

# 运行时本地数据（个人数据，不入库）
logs/
user_data/config.json
user_data/config.json.bak-*
user_data/debug/
# 图像识别图片（个人素材，不入库；目录靠 .gitkeep 入库）
# assets/templates/：用户自己整理/命名的识别图片；assets/anchors/：框选截图生成模板的落盘目录
assets/anchors/*.png
assets/templates/*.png
assets/templates/*.jpg
assets/templates/*.jpeg
assets/templates/*.bmp
assets/templates/*.webp

# 编辑器
.idea/
.vscode/
*.swp
