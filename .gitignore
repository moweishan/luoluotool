# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 构建产物（Phase 7 起；dist/LuoLuoTool 里还会生成 user_data/ 与 logs/，随 dist 一起忽略）
build/
dist/
*.manifest
# PyInstaller 中间产物（自定义 --workpath/--distpath 时可能落在仓库根）
*.pyz
*.pkg
warn-*.txt
xref-*.html

# 运行时本地数据（个人数据，不入库）
logs/
user_data/config.json
user_data/config.json.bak-*
user_data/debug/
assets/anchors/*.png

# 编辑器
.idea/
.vscode/
*.swp
